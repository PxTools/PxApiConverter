@{
    ViewData["Title"] = "Start";
    var urlPrefix = (string?)ViewData["UrlPrefix"] ?? string.Empty;
}

<!-- För säkerhets skull: definiera .fw-bold om tema är Bootstrap 4 (där klassen inte finns) -->
<style>
    .fw-bold {
        font-weight: 700 !important;
    }

    .fw-semibold {
        font-weight: 600 !important;
    }
</style>
<h1 class="mb-4">PxWebApi converter</h1>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4" >
            This converter allows you to transform a PxWebApi 1 query into a PxWebApi 2-compliant query.
            <br />
            <span class="fw-bold">Contact:</span> <a href="mailto:px@scb.se?subject=PxWebApi%20Converter%20Support" class="text-decoration-none">px@scb.se</a>
        </div>
        <div class="alert alert-info mb-4" role="alert">           
            Note: The JsonStat and SDMX formats are not supported in API2.
        </div>

        <form id="convertForm" method="post" action="@Url.Action("ConvertResult", "Home")" class="mb-4">
            <div class="mb-3">
                <label for="urlInput" class="form-label"> Paste your URL in PxWebApi 1 format</label>
                <input type="text" class="form-control" id="urlInput" name="url" placeholder="@urlPrefix..." required />
                <div class="invalid-feedback" id="urlError">URL must start with @urlPrefix</div>
            </div>
            <div class="mb-3">
                <label for="jsonInput" class="form-label">POST query (JSON)</label>
                <textarea class="form-control font-monospace" id="jsonInput" name="body" rows="8" placeholder='{"query": { ... }}'></textarea>
            </div>
            <button id="convertBtn" type="submit" class="btn btn-primary">Convert</button>
            <div id="convertError" class="text-danger mt-2" style="display:none;"></div>
        </form>

        <div id="results" class="d-none">
            <h2 class="h5 mb-3">Resultat</h2>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label >
                        <span class="form-label fw-bold ">GET URL</span>
                        <br />If the GET request fails it may be because the query contains too many values. Try using POST instead.
                    </label>                    
                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" onclick="copyToClipboard('getResult', this)" aria-label="Copy GET URL">Copy GET URL</button>
                </div>
                <pre class="bg-light p-2 border rounded" style="white-space:pre-wrap;" id="getResult"></pre>
            </div>
            <div class="mb-3"><hr style="border:5px solid #0d6efd; opacity:100;" /></div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold mb-0">POST URL</label>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('postUrlResult', this)" aria-label="Copy POST URL">Copy POST URL</button>
                </div>
                <pre class="bg-light p-2 border rounded" style="white-space:pre-wrap;" id="postUrlResult"></pre>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-semibold mb-0">POST Body</label>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" onclick="copyToClipboard('postBodyResult', this)" aria-label="Copy POST Body">Copy POST Body</button>
                </div>
                <pre class="bg-light p-2 border rounded" style="white-space:pre-wrap;" id="postBodyResult"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const urlInput = document.getElementById('urlInput');
    const jsonInput = document.getElementById('jsonInput');
    const resultsDiv = document.getElementById('results');
    const getResultEl = document.getElementById('getResult');
    const postUrlResultEl = document.getElementById('postUrlResult');
    const postBodyResultEl = document.getElementById('postBodyResult');
    const convertForm = document.getElementById('convertForm');
    const urlError = document.getElementById('urlError');
    const convertErrorEl = document.getElementById('convertError');

    const URL_PREFIX = '@urlPrefix';

    function isValidPrefix(value) {
        if(!URL_PREFIX) return true; // allow all if no prefix configured
        return value.startsWith(URL_PREFIX);
    }

    function validateUrlInput() {
        const val = urlInput.value.trim();
        if (!val) {
            urlInput.classList.remove('is-invalid');
            return true; // HTML5 required handles empty
        }
        if (isValidPrefix(val)) {
            urlInput.classList.remove('is-invalid');
            return true;
        } else {
            urlInput.classList.add('is-invalid');
            return false;
        }
    }

    function clearResults() {
        getResultEl.textContent = '';
        postUrlResultEl.textContent = '';
        postBodyResultEl.textContent = '';
        resultsDiv.classList.add('d-none');
    }

    urlInput.addEventListener('input', validateUrlInput);
    urlInput.addEventListener('blur', validateUrlInput);

    convertForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        convertErrorEl.style.display = 'none';
        convertErrorEl.textContent = '';
        const url = urlInput.value.trim();
        const ok = validateUrlInput();
        if (!url || !ok) {
            urlInput.focus();
            return;
        }

        const formData = new FormData(convertForm);

        try {
            const response = await fetch(convertForm.action, {
                method: 'POST',
                body: formData
            });
            if(!response.ok){
                const err = await response.json().catch(()=>({ error: 'Unknown error'}));
                convertErrorEl.textContent = err.error || 'Unknown error';
                convertErrorEl.style.display = 'block';
                clearResults();
                return;
            }
            const data = await response.json();
            getResultEl.textContent = data.getResult || '';
            postUrlResultEl.textContent = data.postUrl || '';
            postBodyResultEl.textContent = data.postBody || 'No JSON provided.';
            resultsDiv.classList.remove('d-none');
        } catch (err) {
            convertErrorEl.textContent = 'Network error';
            convertErrorEl.style.display = 'block';
            clearResults();
        }
    });

    window.copyToClipboard = function (elementId, btn) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = el.textContent;

        const write = async () => {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(text);
            } else {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch {}
                document.body.removeChild(ta);
            }
        };

        write().then(() => {
            if(!btn) return;
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            btn.disabled = true;
            setTimeout(()=> { btn.textContent = original; btn.disabled = false; }, 1500);
        }).catch(()=> {
            convertErrorEl.textContent = 'Could not copy';
            convertErrorEl.style.display = 'block';
        });
    }
</script>
}
